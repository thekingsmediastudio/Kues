# PayPal Sandbox only for the review build. Never put these values in browser code.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BUSINESS_EMAIL=
PAYPAL_BUYER_EMAIL=
PAYPAL_SANDBOX_TEST_PAYEE=
PAYPAL_VAULT_ID=

# Desktop WebAuthn; set RP_ID and EXPECTED_ORIGIN to the exact environment origin.
RP_ID=localhost
EXPECTED_ORIGIN=http://localhost:3000

# Optional cross-origin browser clients. Same-origin desktop requests need no entry.
CORS_ALLOWED_ORIGINS=

# Turso/libSQL. For local SQL-only development, use file:./keus.local.db.
# Remote Turso uses libsql://... plus TURSO_AUTH_TOKEN. Never expose these to the browser.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SESSION_SECRET=

# Keus selected WorkOS Magic Auth for first-party six-digit email codes.
# Keep replacement credentials private. Local callback registered in staging:
# http://localhost:3100/auth/callback. Set AUTH_PROVIDER only with a full config.
PORT=3100
AUTH_PROVIDER=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=
# Enable only after each provider is enabled in the matching WorkOS environment.
WORKOS_GOOGLE_OAUTH_ENABLED=0
WORKOS_GITHUB_OAUTH_ENABLED=0

# Competition access is configured for staging in render.yaml; local environments may leave these blank to test fail-closed behavior.
# Current selected window: PayPal AI Hackathon 2026 submission opening through end of judging, in WAT.
# Staging allowance: 7,000,000 AI tokens per default workspace/account per UTC day.
# If overriding locally, set all three together and include Z or an explicit UTC offset.
# This AI-token quota is separate from onboarding's preview-only purchase-spend examples.
KEUS_COMPETITION_START_AT=
KEUS_COMPETITION_END_AT=
KEUS_COMPETITION_DAILY_TOKEN_LIMIT=

# API Hub (requires WorkOS + Turso). Admin access is restricted to these emails.
# Use a 32-byte base64 key, generated with: openssl rand -base64 32
# Keep the key in the server secret store; changing it makes stored API credentials unreadable.
API_HUB_ADMIN_EMAILS=
API_HUB_ENCRYPTION_KEY=

# Legacy Brevo adapter retained for tests/rollback only. Do not combine with WorkOS.
# Requires AUTH_PROVIDER=brevo and a verified sender/domain; not the selected route.
EMAIL_PROVIDER=
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Keus
APP_BASE_URL=

# Partners (unused until their server-side integrations are implemented)
CHANNEL3_API_KEY=
KERNEL_API_KEY=
