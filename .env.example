# PayPal Sandbox only for the review build. Never put these values in browser code.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional legacy integration fields below; not required by standard checkout.
PAYPAL_WEBHOOK_ID=
PAYPAL_BUSINESS_EMAIL=
PAYPAL_BUYER_EMAIL=
PAYPAL_SANDBOX_TEST_PAYEE=
PAYPAL_VAULT_ID=

# Desktop WebAuthn; set RP_ID and EXPECTED_ORIGIN to the exact environment origin.
RP_ID=localhost
EXPECTED_ORIGIN=http://localhost:3000

# Optional cross-origin browser clients. Same-origin desktop requests need no entry.
CORS_ALLOWED_ORIGINS=

# Turso/libSQL. For local SQL-only development, use file:./keus.local.db.
# Remote Turso uses libsql://... plus TURSO_AUTH_TOKEN. Never expose these to the browser.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SESSION_SECRET=

# Keus WorkOS email/password auth. WorkOS stores passwords; Keus does not.
# Keep server credentials in a private environment/secret store. Staging callback:
# https://keus-staging.onrender.com/auth/callback. Set AUTH_PROVIDER only with a full config.
PORT=3100
AUTH_PROVIDER=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=
# Enable only after each provider is enabled in the matching WorkOS environment.
WORKOS_GOOGLE_OAUTH_ENABLED=0
WORKOS_GITHUB_OAUTH_ENABLED=0

# Competition access is configured for staging in render.yaml; local environments may leave these blank to test fail-closed behavior.
# Current selected window: PayPal AI Hackathon 2026 submission opening through end of judging, in WAT.
# Staging allowance: 7,000,000 AI tokens per verified account per UTC day, aggregated across that account's workspaces.
# If overriding locally, set all three together and include Z or an explicit UTC offset.
# This AI-token quota is separate from onboarding's preview-only purchase-spend examples.
KEUS_COMPETITION_START_AT=
KEUS_COMPETITION_END_AT=
KEUS_COMPETITION_DAILY_TOKEN_LIMIT=

# API Hub (requires WorkOS + Turso). Admin access is restricted to these emails.
# Use a 32-byte base64 key, generated with: openssl rand -base64 32
# Keep the key in the server secret store; changing it makes stored API credentials unreadable.
API_HUB_ADMIN_EMAILS=
API_HUB_ENCRYPTION_KEY=

# Keus-owned AI provider admin API. Keep separate from API Hub credentials.
# Requires WorkOS, Turso, an admin email allowlist, and a 32-byte server-only key.
# Generate with: openssl rand -base64 32. Keep stable: changing it makes stored provider keys and encrypted chat history unreadable.
AI_PROVIDER_ADMIN_EMAILS=
AI_PROVIDER_ENCRYPTION_KEY=
# Admin-only desktop chat smoke test. Keep 0 outside staging; the keus-staging Render blueprint sets 1.
AI_PROVIDER_CHAT_TEST_ENABLED=0
# Allow signed-in staging users to chat through the configured anonymous free model only.
AI_PROVIDER_CHAT_USERS_ENABLED=0

# Legacy Brevo adapter retained for tests/rollback only. Do not combine with WorkOS.
# Requires AUTH_PROVIDER=brevo and a verified sender/domain; not the selected route.
EMAIL_PROVIDER=
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Keus
APP_BASE_URL=

# Partners (unused until their server-side integrations are implemented)
CHANNEL3_API_KEY=
KERNEL_API_KEY=

# Optional original-file library. Disabled by default; server-side values only.
# Confirm a PRIVATE, dedicated B2 bucket and provider-side zero-spend caps first.
WORKSPACE_LIBRARY_ENABLED=0
B2_FREE_CAPS_CONFIRMED=0
B2_S3_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Reviewed Python jobs: migration 0013 and private B2 library required.
# All flags remain OFF pending live validation; no automatic paid fallback.
WORKSPACE_EXECUTION_ENABLED=0
FREESTYLE_FREE_PLAN_CONFIRMED=0
EXECUTION_IMAGE_VERIFIED=0
FREESTYLE_SNAPSHOT_ID=
FREESTYLE_API_KEY=
# Generate a separate random 32-byte base64 key securely; do not paste into chat.
EXECUTION_ENCRYPTION_KEY=

# Optional web research; disabled until a server-side Tavily key is configured.
WEB_RESEARCH_ENABLED=0
TAVILY_API_KEY=

# Hackathon judging: code-gated personal judge workspaces (PayPal sandbox checkout enabled).
# Leave JUDGE_ACCESS_CODE empty to disable the endpoint entirely.
JUDGE_ACCESS_CODE=
JUDGE_FASTLANE_MAX_ACCOUNTS=100
JUDGE_FASTLANE_UNTIL=
